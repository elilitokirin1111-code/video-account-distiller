# Phase 0/1 is fully offline and does not require credentials.
# Future authorized adapters may declare provider-specific variables here.

# Optional account-level GPT analysis. The API reads this variable directly;
# the key is never accepted in an HTTP body or stored in project/task artifacts.
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional OpenKB sidecar. Keep the token value outside distiller.yaml and Git.
DISTILLER_OPENKB_BASE_URL=http://127.0.0.1:7566
DISTILLER_OPENKB_KB=distiller-project
# DISTILLER_OPENKB_API_TOKEN=

# Optional bounded API queue settings. Defaults are shown below.
DISTILLER_TASK_MAX_CONCURRENT=2
DISTILLER_TASK_MAX_PENDING=100
DISTILLER_TASK_WORKFLOW_CONCURRENCY=1
DISTILLER_TASK_PROVIDER_CONCURRENCY=1
DISTILLER_TASK_MODEL_CONCURRENCY=1
DISTILLER_TASK_LEASE_SECONDS=120
DISTILLER_TASK_POLL_INTERVAL_SECONDS=0.05
